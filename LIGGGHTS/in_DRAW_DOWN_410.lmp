#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------    
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#-------------------------------------------------------------------------------- START_PHASE_I --------------------------------------------------------------------------------------------
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

    print "## Phase 1: init ANSYS(R) & generate STL ##"
    shell "S:\START\Windows\01_STL_DERIVATION.bat"                                   # ;generate Ini-STL --> fuer Windows
    #;shell "/S/START/01_STL_DERIVATION.sh"                                                  # ;generate Ini-STL --> fuer LINUX
    #shell mkdir POST

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#-------------------------------------------------------------------------------- STANDARD_KOPF --------------------------------------------------------------------------------------------
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

    atom_style      granular
    atom_modify     map array
    boundary        f f f
    newton          off
    echo            both

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#---------------------------------------------------------------------------------- VARIABLES ----------------------------------------------------------------------------------------------
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
    
    ##variable    delta_t_DEM     equal   1e-5                                              # ;timestep DEM [sec] 2.5e-5
    ##variable    delta_t_FEM     equal   1e-4                                               # ;timestep FEM [sec]     0.005
	variable    delta_t_DEM     equal   2.5e-5                                              # ;timestep DEM [sec] 1e-5
    variable    delta_t_FEM     equal   1e-3 #0.005       
	variable    cpl_step       equal   ${delta_t_FEM}/${delta_t_DEM}                      # ;coupling stepsize [-] TODO
    variable    dump_step       equal   ${cpl_step} #1 #TODO DEBUG 
	variable 	Gesamtzeit		equal   5													# ;Gesamtzeit Simulation [sec]
	variable	settlesteps	equal 0.5/${delta_t_DEM}
	print cpl=${cpl_step}___dump=${dump_step} #1,1000
	variable	dump_end		equal	${Gesamtzeit}/${delta_t_FEM}						# ;dump_end [-]# ;dumpstep [-]
	variable    insertsteps     equal   ${Gesamtzeit}/${delta_t_DEM}					    # ;Gesamtzahl steps
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#--------------------------------------------------------------------------- MAIN_MATERIAL_VARIABLES ---------------------------------------------------------------------------------------
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

#----------------------------------------------------------------------------- Kunststoffgranulat ------------------------------------------------------------------------------------------

    #variable    cor             equal   0.2                                                 # ;coefficient of restitution [-]
   # variable    bulk_dens       equal   577                                                 # ;real bulk dens [kg/m設  --> Kunststoffgranulat
    #variable    poros           equal   0.385                                               # ;porosity [-]
    #variable    dens            equal   ${bulk_dens}/(1-${poros})                           # ;particle density [kg/m設
    #variable    poiss           equal   0.3                                                 # ;poisson ratio [-]
    #variable    shearmod        equal   1e7                                                 # ;shear modulus [N/m淫
    #variable    youngmod        equal   ${shearmod}*(2.0+2.0*${poiss})                      # ;young modulus [N/m淫

    #variable    wallfricW       equal   0.148                                               # ;wall friction particles vs. galvanized  steel [-]
    #variable    wallfricPW      equal   0.220                                               # ;wall friction particles vs. plexiglas [-]
    #variable    wallfricHW      equal   0.                                                  # ;wall friction particles vs. help walls [-]

    #variable    ff              equal   0.12                                                # ;coulomb friction between particles [-]
    #variable    frf             equal   0.30                                                # ;rolling friction between particles [-]
    #variable    CED             equal   0.0                                                 # ;cohesion ernergy density [J]

#----------------------------------------------------------------------------------- Weizen ------------------------------------------------------------------------------------------------

    variable    cor             equal   0.2                                                 # ;coefficient of restitution [-]
    variable    bulk_dens       equal   743                                                 # ;real bulk dens [kg/m ]
    variable    poros           equal   0.402                                               # ;porosity [-]
    variable    dens            equal   ${bulk_dens}/(1-${poros})                           # ;particle density [
   variable    poiss           equal   0.3                                                 # ;poisson ratio [-]
    variable    shearmod        equal   1e7                                                 # ;shear modulus [N/m ]
    variable    youngmod        equal   ${shearmod}*(2.0+2.0*${poiss})                      # ;young modulus [N/m ]

    variable    wallfricW       equal   0.215                                               # ;wall friction particles vs. galvanized  steel [-]
    variable    wallfricPW      equal   0.260                                               # ;wall friction particles vs. plexiglas [-]
    variable    wallfricHW      equal   0.                                                  # ;wall friction particles vs. help walls [-]

    variable    ff              equal   0.170                                               # ;coulomb friction between particles [-]
    variable    frf             equal   0.180                                               # ;rolling friction between particles [-]
    variable    CED             equal   0.0                                                 # ;cohesion ernergy density [J]

