    #;variable    bulk_dens       equal   971                                                 # ;real bulk dens [kg/m ]
    #;variable    poros           equal   0.487                                               # ;porosity [-]
    #;variable    dens            equal   ${bulk_dens}/(1-${poros})                           # ;particle density [kg/m ]
    #;variable    poiss           equal   0.3                                                 # ;poisson ratio [-]
    #;variable    shearmod        equal   1e7                                                 # ;shear modulus [N/m ]
    #;variable    youngmod        equal   ${shearmod}*(2.0+2.0*${poiss})                      # ;young modulus [N/m ]

    #;variable    wallfricW       equal   0.208                                               # ;wall friction particles vs. galvanized  steel [-]
    #;variable    wallfricPW      equal   0.183                                               # ;wall friction particles vs. plexiglas [-]
    #;variable    wallfricHW      equal   0.                                                  # ;wall friction particles vs. help walls [-]

    #;variable    ff              equal   0.5                                                 # ;coulomb friction between particles [-]
    #;variable    frf             equal   0.3                                                 # ;rolling friction between particles [-]
    #;variable    CED             equal   0.0                                                 # ;cohesion ernergy density [J]

